# Copy this file to ".env" in the project root (same folder as pyproject.toml).

# Web server (FastAPI / uvicorn)
AREEB_HOST=0.0.0.0
AREEB_PORT=9000

# Ollama (LLM for chat)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Vast.ai example (mapped port -> Ollama): OLLAMA_BASE_URL=http://136.59.129.136:33481
OLLAMA_MODEL=Qwen2.5:7b-instruct-q4_K_M

# Hugging Face repo for voice/TTS weights (owner/repo, no URL prefix)
# Default: SWivid/Habibi-TTS
AREEB_HF_VOICE_REPO=SWivid/Habibi-TTS

# Optional: external TTS HTTP endpoint (this site will POST JSON by default)
# Preferred: AREEBB_TTS_URL (alias: areebb_tts_url)
# Vast.ai example (mapped port -> voice/TTS): AREEBB_TTS_URL=http://136.59.129.136:33411/api/tts
# AREEBB_TTS_URL=
# Legacy alias: AREEB_REMOTE_TTS_URL, REMOTE_TTS_URL
# REMOTE_TTS_METHOD=POST
# REMOTE_TTS_JSON=1
# REMOTE_TTS_TIMEOUT=300

# Optional: Hugging Face token if you need private/gated model downloads
# HF_TOKEN=
